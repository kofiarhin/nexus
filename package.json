{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "node --watch server/server.js",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "start": "node server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/lint.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "vault:bootstrap": "node scripts/bootstrap-vault.mjs",
    "verify": "npm run lint && npm test && npm run build:client"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.1.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
