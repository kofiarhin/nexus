# Copy to .env and fill in. Never commit .env or any real secret value.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

# GitHub-hosted Vault. Use a fine-grained token limited to the Vault repository
# with Contents: read (add write only when enabling write operations).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_VAULT_REPO=nexus-vault
GITHUB_VAULT_BRANCH=main

# Reasoning provider. Without a key, deterministic reads and administration
# still work; conversation, narratives, and proposals are disabled.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=45000
NVIDIA_MAX_OUTPUT_TOKENS=1200

# Mutations. Writes stay disabled until WRITE_OPERATIONS_ENABLED is true.
# Hard delete additionally requires DESTRUCTIVE_OPERATIONS_ENABLED; archive is
# the default removal method.
WRITE_OPERATIONS_ENABLED=false
DESTRUCTIVE_OPERATIONS_ENABLED=false
AUTO_APPROVE_LOW_RISK=true

# Path allowlists (comma-separated). Anything outside these is refused.
VAULT_READ_PATHS=
VAULT_WRITE_PATHS=

# Retrieval bounds. The whole Vault is never loaded into a model request.
SEARCH_MAX_FILES=250
SEARCH_MAX_RESULTS=40
CONTEXT_MAX_SOURCES=12
CONTEXT_MAX_CHARACTERS=60000

# Rate limits and logging
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
LOG_ENABLED=true
